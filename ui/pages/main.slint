// ─── Palette ──────────────────────────────────────────────────────────────────
global Theme {
    out property <color> bg-top:        #000000;
    out property <color> bg-bottom:     #000000;
    out property <color> card-bg:       #121212;
    out property <color> card-border:   #333333;
    out property <color> accent-donate: #e05a77;
    out property <color> accent-hass:   #5ab8e0;
    out property <color> accent-play:   #7de05a;
    out property <color> accent-cat:    #f1c40f;
    out property <color> accent-member: #8e44ad;
    out property <color> text-primary:  #ffffff;
    out property <color> text-muted:    #a0a0a0;
    out property <color> github-accent: #c9b8ff;
}

// ─── Feature card ─────────────────────────────────────────────────────────────
component FeatureCard inherits Rectangle {
    in property <color>  accent;
    in property <string> icon;
    in property <string> label;
    in property <string> description;
    in property <bool>   enabled: true;
    callback clicked();

    property <float> hover-factor: 0;

    width: 340px;
    height: 220px;
    border-radius: 18px;
    background: Theme.card-bg;
    border-width: 1.5px;
    border-color: enabled ? accent.mix(Theme.card-border, 0.35) : Theme.card-border;
    drop-shadow-blur: 20px;
    drop-shadow-color: enabled ? accent.with-alpha(0.15) : transparent;
    drop-shadow-offset-y: 6px;
    opacity: enabled ? 1.0 : 0.4;

    animate border-color { duration: 200ms; easing: ease-out; }
    animate drop-shadow-color { duration: 200ms; easing: ease-out; }
    animate opacity { duration: 200ms; easing: ease-out; }


    VerticalLayout {
        padding: 28px;
        spacing: 10px;
        alignment: start;

        // Icon + label row
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Text {
                text: icon;
                font-size: 36px;
                vertical-alignment: center;
            }

            Text {
                text: label;
                font-size: 22px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // Divider
        Rectangle {
            width: 48px;
            height: 2px;
            background: enabled ? accent.with-alpha(0.6) : Theme.card-border;
            x: 0px;
        }

        Text {
            text: description;
            font-size: 15px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }

    TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
        pointer-event(e) => {
            if enabled && (e.kind == PointerEventKind.move || e.kind == PointerEventKind.up) {
                root.hover-factor = self.has-hover ? 1.0 : 0.0;
            }
        }
    }
}

// ─── Main page ────────────────────────────────────────────────────────────────
export component Main inherits Rectangle {
    callback donate-clicked();
    callback home-assistant-clicked();
    callback play-clicked();
    callback cat-clicked();
    callback secret-tapped();

    property <int> tap-count: 0;
    tap-reset := Timer {
        interval: 3s;
        running: root.tap-count > 0 && root.tap-count < 5;
        triggered => { root.tap-count = 0; }
    }

    background: #000000;

    VerticalLayout {
        alignment: center;
        spacing: 0px;
        padding-top: 32px;
        padding-bottom: 32px;
        padding-left: 48px;
        padding-right: 48px;

        // ── Header row: logo + title ────────────────────────────────────────
        HorizontalLayout {
            alignment: center;
            spacing: 32px;
            padding-bottom: 8px;

            // Logo — tap 5× for diagnostics
            Rectangle {
                width: 120px;
                height: 128px;

                Image {
                    width: 120px;
                    height: 128px;
                    source: @image-url("../assets/xkem.png");
                    image-fit: contain;
                }

                TouchArea {
                    clicked => {
                        root.tap-count += 1;
                        if root.tap-count >= 5 {
                            root.tap-count = 0;
                            root.secret-tapped();
                        }
                    }
                }
            }

            // Title + tagline
            VerticalLayout {
                alignment: center;
                spacing: 6px;

                Text {
                    text: "Welcome to dram'ma!";
                    font-size: 46px;
                    font-weight: 800;
                    color: Theme.text-primary;
                }

                Text {
                    text: "Your friendly Hacker Embassy station";
                    font-size: 18px;
                    color: Theme.text-muted;
                    font-weight: 400;
                }
            }
        }

        // ── Subtitle ────────────────────────────────────────────────────────
        HorizontalLayout {
            alignment: center;
            padding-top: 12px;
            padding-bottom: 24px;

            Text {
                text: "Here you can:";
                font-size: 22px;
                font-weight: 600;
                color: Theme.github-accent;
            }
        }

        // ── Feature cards ───────────────────────────────────────────────────
        VerticalLayout {
            spacing: 20px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                spacing: 24px;

                FeatureCard {
                    accent: Theme.accent-donate;
                    icon: "💸";
                    label: "Donate";
                    description: "Support Hacker Embassy directly.\nEvery coin counts!";
                    clicked => { root.donate-clicked(); }
                }

                FeatureCard {
                    accent: Theme.accent-hass;
                    icon: "🏠";
                    label: "Control Space";
                    description: "Manage lights, climate & more\nvia Home Assistant.";
                    clicked => { root.home-assistant-clicked(); }
                }

                FeatureCard {
                    accent: Theme.accent-play;
                    icon: "🎮";
                    label: "Play Games";
                    description: "Insert coins and enjoy\nretro games on the machine!";
                    clicked => { root.play-clicked(); }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 24px;

                FeatureCard {
                    accent: Theme.accent-cat;
                    icon: "🐈";
                    label: "Print-a-cat";
                    description: "Get a random cat receipt!\nActive even for 0 ֏.";
                    clicked => { root.cat-clicked(); }
                }

                FeatureCard {
                    accent: Theme.accent-member;
                    icon: "👤";
                    label: "Member space";
                    description: "Manage embassy memberships.\nWork in progress.";
                    enabled: false;
                }

                // Spacer card so row 2 aligns under row 1 columns
                Rectangle {
                    width: 340px;
                    height: 220px;
                }
            }
        }

        // ── Contribute footer ───────────────────────────────────────────────
        HorizontalLayout {
            alignment: center;
            padding-top: 16px;
            spacing: 8px;

            Text {
                text: "Wanna contribute?";
                font-size: 16px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            Text {
                text: "PR to";
                font-size: 16px;
                color: Theme.text-muted;
                vertical-alignment: center;
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                height: 32px;

                Rectangle {
                    border-radius: 8px;
                    background: Theme.github-accent.with-alpha(0.12);
                    border-width: 1px;
                    border-color: Theme.github-accent.with-alpha(0.4);

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Text {
                            text: "github.com/hackerembassy/dramma";
                            font-size: 15px;
                            color: Theme.github-accent;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
